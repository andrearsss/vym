{
	"info": {
		"_postman_id": "03f4b071-9a1d-4e86-a7a9-42bdc34c4ef2",
		"name": "Image Service",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
		"_exporter_id": "15923526"
	},
	"item": [
		{
			"name": "upload",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"// Save the returned file key to the environment variable\r",
							"var jsonData = pm.response.json();\r",
							"pm.environment.set(\"filename\", jsonData.filename);\r",
							"pm.test(\"Status code is 200\", function () {\r",
							"    pm.response.to.have.status(200);\r",
							"});\r",
							""
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
			"protocolProfileBehavior": {
				"disabledSystemHeaders": {}
			},
			"request": {
				"auth": {
					"type": "bearer",
					"bearer": [
						{
							"key": "token",
							"value": "{{auth_token}}",
							"type": "string"
						}
					]
				},
				"method": "POST",
				"header": [
					{
						"key": "x-user-id",
						"value": "{{user_id}}",
						"type": "text"
					}
				],
				"body": {
					"mode": "formdata",
					"formdata": [
						{
							"key": "file",
							"type": "file",
							"src": "squat.png"
						}
					]
				},
				"url": {
					"raw": "{{base_url}}/images/upload",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"images",
						"upload"
					]
				}
			},
			"response": []
		},
		{
			"name": "filename",
			"request": {
				"auth": {
					"type": "bearer",
					"bearer": [
						{
							"key": "token",
							"value": "{{auth_token}}",
							"type": "string"
						}
					]
				},
				"method": "GET",
				"header": [
					{
						"key": "x-user-id",
						"value": "{{user_id}}",
						"type": "text"
					}
				],
				"url": {
					"raw": "{{base_url}}/images/{{filename}}",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"images",
						"{{filename}}"
					]
				}
			},
			"response": []
		},
		{
			"name": "list",
			"request": {
				"auth": {
					"type": "bearer",
					"bearer": [
						{
							"key": "token",
							"value": "{{auth_token}}",
							"type": "string"
						}
					]
				},
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{base_url}}/images/list",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"images",
						"list"
					]
				}
			},
			"response": []
		}
	]
}