		{
			"name": "test login",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"// Save the returned token to the environment variable (existing functionality)\r",
							"var jsonData = pm.response.json();\r",
							"pm.environment.set(\"auth_token\", jsonData.access_token);\r",
							"\r",
							"// Extract the 'id' from the 'user' object and save it to an environment variable\r",
							"var userId = jsonData.user.id;\r",
							"pm.environment.set(\"user_id\", userId);\r",
							"\r",
							"// Test for status code (existing functionality)\r",
							"pm.test(\"Status code is 200\", function () {\r",
							"    pm.response.to.have.status(200);\r",
							"});"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
			"request": {
				"auth": {
					"type": "noauth"
				},
				"method": "POST",
				"header": [],
				"body": {
					"mode": "raw",
					"raw": "{\r\n    \"email\": \"{{email}}\",\r\n    \"password\": \"{{password}}\"\r\n}\r\n",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{base_url}}/auth/login",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"auth",
						"login"
					]
				}
			},
			"response": []
